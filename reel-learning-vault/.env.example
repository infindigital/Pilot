# Copy this file to ".env" and fill in your Supabase project values.
# Find them in your Supabase dashboard: Project Settings → API.
#
# Both values are safe to expose in a front-end app (the anon key is public and
# protected by Row Level Security). Never put the service_role key here.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
